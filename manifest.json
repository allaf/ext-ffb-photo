{
  "manifest_version": 3,
  "name": "FFBoxe - Outils club",
  "version": "0.5.0",
  "description": "Télécharge les photos FFBoxe, les synchronise avec Google Sheets et remplit les inscriptions préparées.",
  "permissions": [
    "menus",
    "downloads",
    "notifications",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://extranet.ffboxe.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "FFBoxe - Outils club",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://extranet.ffboxe.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ffboxe-photo-downloader@rapb-boxe.fr",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo",
          "personallyIdentifyingInfo",
          "websiteContent"
        ]
      }
    }
  }
}
